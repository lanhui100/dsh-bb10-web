[Unit]
Description=DSH BB10 Web Companion Service
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=%I
WorkingDirectory=/opt/dsh-bb10-web
EnvironmentFile=-/etc/default/dsh-bb10-web
ExecStart=/usr/bin/node server.mjs
Restart=on-failure
RestartSec=10s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=dsh-bb10-web

[Install]
WantedBy=multi-user.target
