# ==============================================================================
# dsh-bb10-web Environment Configuration Template
# ==============================================================================

# [Network & Listening Configuration]
# Port on which the dsh-bb10-web server listens (Default: 3090)
PORT=3090

# Host binding address (Use 127.0.0.1 for local/reverse-proxy only, 0.0.0.0 for all interfaces/containers)
HOST=0.0.0.0

# [Upstream DSH Connection (Decoupled)]
# URL of the upstream DeepSeek Harness (DSH) Web host RPC service.
# - Bare-metal / Native setup: http://127.0.0.1:3080
# - Docker container accessing host DSH: http://host.docker.internal:3080
# - Remote host: http://<upstream-host-ip>:3080
DSH_WEB_URL=http://127.0.0.1:3080

# Path to the DSH configuration and session storage root.
# In native deployment, defaults to ~/.dsh.
# In Docker compose, maps to the host DSH data directory.
DSH_HOME=~/.dsh

# Optional: Path to DSH source checkout if falling back to local SDK engine
# DSH_ROOT=/path/to/deepseek-harness

# [Security & Access Control]
# Optional bearer / cookie authentication token (min 16 characters if enabled).
# Leave empty to disable token authentication.
Q20_AUTH_TOKEN=

# Secure cookie flag (Set to 1 if deployed strictly behind HTTPS reverse proxy, 0 for HTTP)
Q20_COOKIE_SECURE=0

# Allowed CORS origins (comma-separated list, e.g. https://q20.example.com,http://localhost:3090)
# Leave empty to allow standard same-origin requests
ALLOWED_ORIGINS=
